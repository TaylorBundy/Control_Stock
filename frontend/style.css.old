* {
  box-sizing: border-box;
}
:root {
  --green: #235b43;
  --green2: #2e7655;
  --ink: #1d2a24;
  --muted: #738078;
  --line: #e5ebe6;
  --bg: #f5f7f5;
  --white: #fff;
}
body {
  margin: 0;
  background: var(--bg);
  color: var(--ink);
  font:
    14px/1.45 Inter,
    Segoe UI,
    Arial,
    sans-serif;
}
.shell {
  display: flex;
  min-height: 100vh;
}
.sidebar {
  width: 245px;
  background: #173e30;
  color: #eaf3ed;
  padding: 25px 16px;
  display: flex;
  flex-direction: column;
  flex-shrink: 0;
}
.brand {
  display: flex;
  align-items: center;
  gap: 11px;
  padding: 0 8px 34px;
}
.brand-icon {
  width: 38px;
  height: 38px;
  border-radius: 12px;
  background: #d9eee0;
  color: #24583f;
  display: grid;
  place-items: center;
  font-size: 21px;
  font-weight: 800;
}
.brand b {
  display: block;
  font-size: 15px;
}
.brand small {
  color: #a9c7b5;
  letter-spacing: 2px;
  font-size: 10px;
}
.sidebar nav {
  display: grid;
  gap: 7px;
}
.nav {
  border: 0;
  background: transparent;
  color: #c6d8cd;
  text-align: left;
  padding: 12px 13px;
  border-radius: 9px;
  font-size: 16px;
  cursor: pointer;
}
.nav span {
  font-size: 13px;
  margin-left: 9px;
}
.nav:hover,
.nav.active {
  background: #2b6048;
  color: #fff;
}
.side-foot {
  margin-top: auto;
  color: #b2c9bb;
  font-size: 11px;
  padding: 15px 8px;
}
.dot {
  display: inline-block;
  width: 7px;
  height: 7px;
  background: #67d59a;
  border-radius: 50%;
  margin-right: 7px;
}
.main {
  min-width: 0;
  flex: 1;
  padding: 30px 34px 60px;
  max-width: 1600px;
  margin: 0 auto;
}
.topbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 15px;
  margin-bottom: 26px;
}
.eyebrow {
  font-size: 10px;
  letter-spacing: 1.7px;
  color: var(--green2);
  font-weight: 800;
}
.topbar h1 {
  margin: 3px 0 0;
  font-size: 27px;
}
.top-actions {
  display: flex;
  align-items: center;
  gap: 18px;
}
.server-status {
  font-size: 11px;
  color: #32815a;
}
.primary,
.secondary,
.ghost {
  border: 0;
  border-radius: 8px;
  padding: 10px 15px;
  font-weight: 650;
  cursor: pointer;
}
.primary {
  background: var(--green);
  color: white;
}
.primary:hover {
  background: var(--green2);
}
.secondary {
  background: #e9efeb;
  color: #315b45;
}
.ghost {
  background: transparent;
  color: var(--green2);
}
.full {
  width: 100%;
  margin-top: 12px;
}
.view {
  display: none;
}
.view.active {
  display: block;
}
.stats {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 15px;
  margin-bottom: 20px;
}
.stat,
.panel {
  background: white;
  border: 1px solid var(--line);
  border-radius: 13px;
}
.stat {
  padding: 18px 20px;
}
.stat span {
  color: var(--muted);
  font-size: 12px;
}
.stat strong {
  display: block;
  font-size: 29px;
  margin: 8px 0 2px;
  letter-spacing: -1px;
}
.stat small {
  color: #8b968f;
  font-size: 11px;
}
.stat.warning strong {
  color: #bb6c34;
}
.panel {
  margin-bottom: 18px;
  overflow: hidden;
}
.panel-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18px 20px 12px;
}
.panel h2,
.file-card h2 {
  font-size: 16px;
  margin: 0;
}
.panel p,
.file-card p {
  color: var(--muted);
  font-size: 12px;
  margin: 4px 0 0;
}
.table-wrap {
  width: 100%;
  overflow: auto;
}
table {
  width: 100%;
  border-collapse: collapse;
  white-space: nowrap;
}
th {
  text-align: left;
  color: #7c8981;
  font-size: 10px;
  text-transform: uppercase;
  letter-spacing: 0.7px;
  background: #fafcfb;
  padding: 12px 15px;
  border-top: 1px solid var(--line);
  border-bottom: 1px solid var(--line);
}
td {
  padding: 12px 15px;
  border-bottom: 1px solid #edf1ee;
  font-size: 12px;
}
tbody tr:last-child td {
  border-bottom: 0;
}
tbody tr:hover {
  background: #fbfdfb;
}
.badge {
  display: inline-block;
  border-radius: 20px;
  padding: 4px 8px;
  font-size: 10px;
  font-weight: 700;
}
.in {
  background: #e3f3e9;
  color: #287247;
}
.out {
  background: #fff0e8;
  color: #b55b2d;
}
.negative {
  color: #bd583e;
  font-weight: 700;
}
.actions {
  display: flex;
  gap: 6px;
}
.small-btn {
  border: 1px solid var(--line);
  background: white;
  border-radius: 6px;
  padding: 5px 8px;
  cursor: pointer;
  color: #476253;
}
.toolbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
  margin-bottom: 15px;
}
.toolbar input {
  max-width: 440px;
  width: 100%;
}
input,
select,
textarea {
  font: inherit;
  border: 1px solid #dce5de;
  border-radius: 7px;
  padding: 10px 11px;
  background: white;
  color: var(--ink);
  width: 100%;
  outline: none;
}
input:focus,
select:focus,
textarea:focus {
  border-color: #6ba783;
  box-shadow: 0 0 0 3px #e5f2e9;
}
label {
  display: grid;
  gap: 6px;
  font-size: 11px;
  color: #68766e;
  font-weight: 650;
}
.hint {
  font-size: 11px;
  color: var(--muted);
}
.file-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 15px;
}
.file-card {
  padding: 22px;
}
.file-icon {
  width: 40px;
  height: 40px;
  border-radius: 11px;
  background: #e9f3ec;
  color: var(--green);
  display: grid;
  place-items: center;
  font-size: 22px;
  margin-bottom: 14px;
}
.file-input {
  display: block;
  margin-top: 18px;
  border: 1px dashed #b9cbbf;
  border-radius: 8px;
  padding: 10px;
  color: var(--green);
  text-align: center;
  cursor: pointer;
}
.file-input input {
  display: none;
}
.result {
  font-size: 11px;
  margin-top: 10px;
  color: var(--green);
}
.notice {
  background: #eef5ef;
  border: 1px solid #dce9df;
  border-radius: 10px;
  padding: 15px 18px;
  font-size: 12px;
  color: #496253;
  line-height: 1.7;
}
.notice code {
  background: #fff;
  padding: 2px 5px;
  border-radius: 4px;
}
.dialog-head {
  display: flex;
  justify-content: space-between;
  align-items: start;
  margin-bottom: 22px;
}
.dialog-head h2 {
  margin: 4px 0 0;
  font-size: 20px;
}
.close {
  border: 0;
  background: transparent;
  font-size: 25px;
  color: #758078;
  cursor: pointer;
}
.form-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 15px;
}
.wide {
  grid-column: 1/-1;
}
.dialog-actions {
  display: flex;
  justify-content: flex-end;
  gap: 9px;
  margin-top: 22px;
}
dialog {
  border: 0;
  border-radius: 15px;
  padding: 25px;
  width: min(600px, calc(100% - 25px));
  box-shadow: 0 25px 80px #102d1e40;
}
dialog::backdrop {
  background: #13251db3;
}
.toast {
  position: fixed;
  right: 25px;
  bottom: 25px;
  background: #203e2f;
  color: white;
  padding: 12px 18px;
  border-radius: 9px;
  opacity: 0;
  transform: translateY(10px);
  transition: 0.2s;
  pointer-events: none;
  z-index: 10;
}
.toast.show {
  opacity: 1;
  transform: translateY(0);
}
.empty {
  text-align: center;
  color: #99a49d;
  padding: 24px;
}
.foto-producto {
    width: 65px;
    height: 65px;
    object-fit: contain;
    border-radius: 8px;
    background: white;
    border: 1px solid #ddd;
    padding: 3px;
}
@media (max-width: 1050px) {
  .stats {
    grid-template-columns: repeat(2, 1fr);
  }
  .file-grid {
    grid-template-columns: 1fr 1fr;
  }
}
@media (max-width: 700px) {
  .shell {
    display: block;
  }
  .sidebar {
    width: auto;
    padding: 12px 13px;
  }
  .brand {
    padding: 0 5px 12px;
  }
  .sidebar nav {
    display: flex;
    overflow: auto;
  }
  .nav {
    padding: 9px 10px;
    white-space: nowrap;
  }
  .nav span {
    margin-left: 5px;
  }
  .side-foot {
    display: none;
  }
  .main {
    padding: 20px 13px 40px;
  }
  .topbar {
    align-items: flex-start;
    flex-direction: column;
  }
  .topbar h1 {
    font-size: 23px;
  }
  .top-actions {
    width: 100%;
    justify-content: space-between;
  }
  .stats {
    gap: 8px;
  }
  .stat {
    padding: 13px;
  }
  .stat strong {
    font-size: 23px;
  }
  .file-grid {
    grid-template-columns: 1fr;
  }
  .toolbar {
    align-items: stretch;
    flex-direction: column;
  }
  .toolbar input {
    max-width: none;
  }
  .form-grid {
    grid-template-columns: 1fr;
  }
  .wide {
    grid-column: auto;
  }
}
